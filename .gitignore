# Local secrets and machine-specific settings.
# backend/local-config.php carries this machine's database host and password;
# backend/local-config.sample.php is the template that IS tracked.
backend/local-config.php

# The live review-desk password hash. Protected by standing instruction, and it
# must never enter history: a commit is a copy you cannot delete later without
# rewriting the repository. Regenerate with: php admin/set-password.php
backend/admin-hash.php

# Files clients actually uploaded through the quote form. These are people's
# artwork, not source code. The directory's .htaccess stays tracked so the
# protection travels with the project.
backend/storage/*
!backend/storage/.htaccess

# Hand-over backups of earlier versions of the pages, made before each editing
# round. They are a safety net for this machine, not project history.
pre-fix-files/

# Generated by: tools/audit.js
tools/audit-report.txt

# Operating-system noise.
Thumbs.db
Desktop.ini
ehthumbs.db
.DS_Store
